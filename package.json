{
  "name": "like-ar",
  "description": "Using objects like arrays with map, filter, forEach and others coming soon.",
  "version": "0.5.5",
  "author": "Codenautas <codenautas@googlegroups.com>",
  "repository": "codenautas/like-ar",
  "license": "MIT",
  "main": "like-ar.js",
  "types": "like-ar.d.ts",
  "files": [
    "like-ar.js",
    "like-ar.d.ts"
  ],
  "overrides": {
    "diff": ">=8.0.2",
    "serialize-javascript": ">=7.0.0",
    "uuid": ">=14.0.0",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.1.0"
    }
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "discrepances": "^0.3.2",
    "expect.js": "^0.3.1",
    "json4all": "^1.4.6",
    "mocha": "^12.0.3",
    "nyc": "^18.0.0",
    "qa-control": "^0.14.1",
    "require-bro": "^0.4.1",
    "server4test": "^2.0.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  },
  "engines": {
    "node": ">= 16.0.0"
  },
  "scripts": {
    "test": "mocha --reporter spec --bail --check-leaks test/",
    "test-nc": "mocha --reporter spec --bail --check-leaks --no-colors test/",
    "test-ci": "nyc --silent mocha --reporter spec --bail --check-leaks --no-colors test/ && npm run test-navigator && nyc report",
    "build-test": "nyc instrument --delete like-ar.js local-instrumented",
    "test-navigator": "npm run build-test && server4test --run-browser chrome,firefox",
    "test-navigator-inf": "npm run build-test && server4test"
  },
  "nyc": {
    "lines": 95,
    "statements": 95,
    "functions": 95,
    "branches": 95,
    "extension": [
      ".js"
    ],
    "exclude": [
      "test"
    ],
    "include": [
      "*.js"
    ],
    "reporter": [
      "html",
      "lcov",
      "text-summary"
    ],
    "sourceMap": true,
    "instrument": true,
    "all": true,
    "check-coverage": true
  },
  "qa-control": {
    "coverage": 98,
    "run-in": "both",
    "type": "lib",
    "test-appveyor": true,
    "gha": "all",
    "silenced": [
      "eslint_warnings_in_file_1"
    ]
  }
}
